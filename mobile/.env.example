# Base URL of the ClearBeam site + API. Copy to `.env` to override.
# Production (default if unset):
EXPO_PUBLIC_API_BASE_URL=https://clearbeamandautocare.com

# To test against a Netlify deploy-preview instead, use its URL, e.g.:
# EXPO_PUBLIC_API_BASE_URL=https://deploy-preview-6--gentle-marigold-891fdb.netlify.app
